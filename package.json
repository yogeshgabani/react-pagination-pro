{
  "name": "react-next-pagination-pro",
  "version": "0.2.0",
  "description": "All-in-one React & Next.js pagination: 130+ styled variants, headless hooks, infinite scroll, load-more, cursor, URL sync, table footer, carousel dots, A-Z index. Accessible, dark mode, RTL, TypeScript.",
  "keywords": [
    "react",
    "pagination",
    "paginate",
    "paginator",
    "pager",
    "react-pagination",
    "react-paginate",
    "react-component",
    "nextjs",
    "next.js",
    "vite",
    "hooks",
    "headless",
    "typescript",
    "table-pagination",
    "data-table",
    "cursor-pagination",
    "infinite-scroll",
    "load-more",
    "carousel",
    "dots",
    "alphabet",
    "a-z",
    "dark-mode",
    "rtl",
    "accessible",
    "a11y"
  ],
  "license": "MIT",
  "author": "Yogesh Gabani",
  "homepage": "https://react-next-pagination.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshgabani/react-pagination-pro.git"
  },
  "bugs": {
    "url": "https://github.com/yogeshgabani/react-pagination-pro/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite",
    "demo:build": "vite build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^24.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "0.33.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "fflate": "~0.7.5"
  }
}
