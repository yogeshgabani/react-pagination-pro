# Demo site configuration — see .env.example for the full list.
# Empty value => the link opens a "Coming soon" dialog instead of navigating.

VITE_GITHUB_URL=
VITE_NPM_URL=

VITE_AUTHOR_NAME=Yogesh Gabani
VITE_AUTHOR_URL=

VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
VITE_X_URL=
VITE_LINKEDIN_URL=

# "Last updated" is stamped at build time; set only to pin a date.
VITE_LAST_UPDATED=

# Live counters — hits per page view, visitors once per browser.
# Every visit counts, dev included; use a throwaway namespace while developing.
VITE_COUNTER_NAMESPACE=react-next-pagination-pro
VITE_COUNTER_API=https://abacus.jasoncameron.dev
