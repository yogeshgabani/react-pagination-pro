# --- Demo site configuration -------------------------------------------------
# Copy this file to `.env` and fill in the URLs you have.
# Any link left EMPTY renders as a "Coming soon" button instead of a dead link.
# Vite only exposes variables prefixed with VITE_.

# Project links (footer action buttons + header)
VITE_GITHUB_URL=
VITE_NPM_URL=

# Author / "Built by"
VITE_AUTHOR_NAME=Yogesh Gabani
VITE_AUTHOR_URL=

# Social profiles ("Connect with ..." row)
VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
VITE_X_URL=
VITE_LINKEDIN_URL=

# --- Open Graph share card ---------------------------------------------------
# The build generates og-image.png and the og:/twitter: meta tags. Platforms
# need an absolute image URL; Netlify supplies it automatically. Set this only
# when hosting elsewhere (e.g. https://pagination.example.com).
# Preview the card while developing at http://localhost:5188/og-image.png
VITE_SITE_URL=

# --- Footer stat cards -------------------------------------------------------
# "npm downloads" is read live from api.npmjs.org — nothing to configure.
# "Last updated" is stamped automatically at build time. Set this only to pin a
# specific date (any parseable string, e.g. 2026-05-27).
VITE_LAST_UPDATED=

# Live hit / visitor counters. Set a namespace to switch them on — hits count
# every page view, visitors count once per browser. Leave blank to keep the
# counters off (the cards then show "—").
# NOTE: every visit counts, local dev included. Use a throwaway namespace while
# developing (e.g. react-next-pagination-pro-dev) to keep the real numbers clean.
VITE_COUNTER_NAMESPACE=react-next-pagination-pro

# Counter backend. Defaults to Abacus (free, no signup, no PII). Any service
# exposing GET /hit/<ns>/<key> and GET /get/<ns>/<key> -> {"value": N} works.
VITE_COUNTER_API=https://abacus.jasoncameron.dev
